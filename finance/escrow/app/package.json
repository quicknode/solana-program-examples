{
  "name": "escrow-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser frontend for the escrow Solana program: browse offers, take one, make your own, cancel your own.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-reporter=spec tests/*.test.ts",
    "test:e2e": "tsx --test --test-reporter=spec --test-concurrency=1 tests/e2e/*.e2e.ts",
    "build-idl": "tsx scripts/build-idl.ts",
    "generate-client": "tsx scripts/generate-client.ts"
  },
  "engines": {
    "node": ">=20.18.0"
  },
  "dependencies": {
    "@solana-program/token": "0.18.0",
    "@solana-program/token-2022": "0.20.0",
    "@solana/kit": "8.5.0",
    "@solana/kit-plugin-rpc": "0.22.0",
    "@solana/kit-plugin-wallet": "0.22.0",
    "@solana/react": "8.5.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@codama/nodes-from-anchor": "1.5.6",
    "@codama/renderers-js": "2.8.0",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "^8.18.2",
    "codama": "1.11.0",
    "playwright": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "ws": "^8.22.0"
  }
}
