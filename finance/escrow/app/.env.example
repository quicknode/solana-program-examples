# Which cluster the app talks to: localnet, devnet, testnet or mainnet.
# Wallets are offered only if they support this cluster.
NEXT_PUBLIC_CLUSTER=devnet

# RPC endpoint. Defaults to the cluster's public endpoint; set your own
# Quicknode endpoint here for anything beyond light testing.
# NEXT_PUBLIC_RPC_URL=https://your-endpoint.solana-devnet.quiknode.pro/your-token/

# WebSocket endpoint, if it is not the RPC URL with https swapped for wss.
# NEXT_PUBLIC_RPC_SUBSCRIPTIONS_URL=

# Where the escrow program is deployed. Defaults to the address in the
# program's declare_id!; set it if you deployed under a different address.
# NEXT_PUBLIC_ESCROW_PROGRAM_ADDRESS=
